# Shared secret guarding /api/process-passport and /api/process-match.
# These use the Supabase service-role key and bypass RLS, so they must never
# be reachable without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# AES-256-GCM key encrypting GitHub OAuth tokens at rest (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes existing stored tokens undecryptable.
TOKEN_ENCRYPTION_KEY=

# Backend CORS allowlist (comma separated). Never use "*".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
