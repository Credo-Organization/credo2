# ?????? Supabase ??????
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ?????? GitHub OAuth (separate from Supabase) ??????
GITHUB_CLIENT_ID=<your-github-client-id>
GITHUB_CLIENT_SECRET=<your-github-client-secret>

# ?????? App ??????
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Credify

# ?????? Universal AI Provider (OpenRouter) ??????
OPENROUTER_API_KEY=<your-openrouter-api-key>

# ?????? Python Backend API ??????
PYTHON_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_PYTHON_BACKEND_URL=http://localhost:8000

# Shared secret guarding /api/process-passport and /api/process-match.
# These use the Supabase service-role key and bypass RLS, so they must never
# be reachable without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=

# AES-256-GCM key encrypting GitHub OAuth tokens at rest (64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this makes existing stored tokens undecryptable.
TOKEN_ENCRYPTION_KEY=

# Backend CORS allowlist (comma separated). Never use "*".
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
