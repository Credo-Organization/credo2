# The AI gateway. AI_BASE_URL and the key must belong to the SAME provider.
#
# This is the trap worth stating plainly: the variable is named
# OPENROUTER_API_KEY for historical reasons, but the service defaults to the
# AICredits gateway. An OpenRouter key against that base URL returns 401 on
# every model, and the matcher then falls back to a deterministic heuristic
# that still answers HTTP 200 with a plausible-looking score - so the failure
# is invisible unless you read the logs. Set both, together, or neither.
AI_BASE_URL="https://aicredits.in/v1"
OPENROUTER_API_KEY="<key-for-the-gateway-named-in-AI_BASE_URL>"

# Optional direct-to-Google fallback, used only if the gateway is unreachable.
GOOGLE_API_KEY="<your-google-generative-ai-key>"

GITHUB_CLIENT_ID="<your-github-client-id>"
GITHUB_CLIENT_SECRET="<your-github-client-secret>"
SESSION_SECRET="<random-session-secret>"

# Comma-separated browser origins allowed to call this API. Unset means
# localhost only, which will reject a deployed frontend.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
